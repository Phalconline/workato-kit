root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# Generated or copied verbatim: leave the bytes alone.
[workato/workspaces/**.json]
insert_final_newline = unset
trim_trailing_whitespace = unset
